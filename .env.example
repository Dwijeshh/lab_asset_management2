# Database Connection
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Security - JWT session signing (REQUIRED for production)
# Generate with: openssl rand -base64 32
# JWT_SECRET=
# Canonical public origin used for CSRF checks in production, e.g. https://assets.example.edu
# APP_ORIGIN=

# Authentication provider: local (password login) or keycloak (OIDC SSO).
# AUTH_PROVIDER=local

# Keycloak OIDC (required when AUTH_PROVIDER=keycloak)
# KEYCLOAK_URL=https://auth.example.com/realms/mahe
# KEYCLOAK_CLIENT_ID=lab-asset-app
# KEYCLOAK_CLIENT_SECRET=

# Environment
NODE_ENV=development

# Optional Configuration
# LOG_LEVEL=info
# ALLOWED_ORIGINS=https://yourdomain.com
# MAX_REQUEST_SIZE=1mb

# Rate limiting: Redis is required in production and shared across instances.
# Development/test may use the in-memory store. Set TRUST_PROXY=true ONLY
# when running behind a proxy that overwrites X-Forwarded-For (Vercel, nginx);
# otherwise the header is attacker-controlled and is ignored.
# REDIS_URL=redis://localhost:6379
# TRUST_PROXY=true

# Request body size cap for API routes (middleware), e.g. 512kb, 2mb
# MAX_REQUEST_SIZE=1mb

# Error Monitoring (optional)
# SENTRY_DSN=

# Monthly report scheduling and institution-local calendar boundaries
INSTITUTION_TIMEZONE=Asia/Kolkata
# Set either REPORT_SCHEDULER_SECRET or CRON_SECRET to a random server secret.
# Vercel Cron sends CRON_SECRET as an Authorization: Bearer token.
REPORT_SCHEDULER_SECRET=

# SMTP delivery for scheduled reports and admin test-send
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Database Connection
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Security - JWT session signing (REQUIRED for production)
# Generate with: openssl rand -base64 32
# JWT_SECRET=

# Authentication provider: local (password login) or keycloak (OIDC SSO).
# AUTH_PROVIDER=local

# Keycloak OIDC (required when AUTH_PROVIDER=keycloak)
# KEYCLOAK_URL=https://auth.example.com/realms/mahe
# KEYCLOAK_CLIENT_ID=lab-asset-app
# KEYCLOAK_CLIENT_SECRET=

# Environment
NODE_ENV=development

# Optional Configuration
# LOG_LEVEL=info
# ALLOWED_ORIGINS=https://yourdomain.com
# MAX_REQUEST_SIZE=1mb

# Rate limiting: in-memory by default (single instance). Set REDIS_URL to
# share rate-limit state across replicas via Redis. Set TRUST_PROXY=true ONLY
# when running behind a proxy that overwrites X-Forwarded-For (Vercel, nginx);
# otherwise the header is attacker-controlled and is ignored.
# REDIS_URL=redis://localhost:6379
# TRUST_PROXY=true

# Request body size cap for API routes (middleware), e.g. 512kb, 2mb
# MAX_REQUEST_SIZE=1mb

# Error Monitoring (optional)
# SENTRY_DSN=